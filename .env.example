# Cloudflare R2. Copy to .env and fill in. .env is gitignored.
# Dashboard -> R2 -> Manage API Tokens -> Create API Token
#   Permission: Object Read & Write, scoped to one bucket
FCKDB_BUCKET=fckdb
FCKDB_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
